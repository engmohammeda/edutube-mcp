GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_MODEL=gemini-2.5-pro
YT_DLP_PATH=yt-dlp
MCP_LOG_LEVEL=warn
# LOCAL PATCH: optional explicit rotation order (comma separated). When unset,
# the server auto-discovers all Gemini models available to the key and rotates
# across their independent free-tier pools on 429/quota errors.
# GEMINI_MODEL_ROTATION=gemini-2.5-flash,gemini-3-flash-preview,gemini-2.5-flash-lite
# Optional EXTRA Gemini keys (comma separated). Each key adds its own quota
# pools; rotation tries every (key, model) pair on 429.
# GEMINI_API_KEYS=second_key_here,third_key_here
